{
  "name": "pianoflow",
  "version": "0.30.0",
  "private": true,
  "description": "Open-source falling-notes piano practice app — a libre Synthesia alternative.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "pnpm --filter @pianoflow/web dev",
    "build": "pnpm --filter @pianoflow/web build",
    "preview": "pnpm --filter @pianoflow/web preview",
    "test": "vitest run",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "songs": "node scripts/generate-songs.mjs",
    "soundfont": "node scripts/fetch-soundfont.mjs",
    "render-preview": "node scripts/render-preview.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "gl": "^8.1.6",
    "jsdom": "^31.0.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
